#!/usr/bin/env bash
# gemini를 띄우면서 이 세션의 id를 aisurada 엔진이 읽을 수 있게 넣어 주는 래퍼입니다.
#
# Gemini CLI의 셸 도구와 MCP 서버는 세션 id를 환경변수로 받지 못합니다. 그래서 시작하기 전에
# UUID를 하나 만들어 `gemini --session-id`로 넘기고, 같은 값을 AISURADA_SESSION_ID로 내보냅니다.
# 엔진은 이 값을 노트 머리말에 sessionId와 sessionAgent: gemini로 적습니다.
#
#   ais-gemini [gemini 인자...]
#
# - 이미 `--session-id <id>`를 줬으면 그 값을 씁니다.
# - `--resume <UUID>`로 이어 열면 그 UUID를 씁니다. `--resume latest`나 번호는 id를 알 수 없어서
#   변수를 넣지 않습니다(노트에 세션이 남지 않습니다).
# - `--help`, `--version`, `mcp` 같은 부속 명령은 손대지 않고 그대로 넘깁니다.
# - 다른 에이전트에서 물려받은 AISURADA_SESSION_*와 Claude·Codex 세션 변수는 지우거나 덮어씁니다.
#
# 쓰는 gemini 실행 파일을 바꾸려면 AISURADA_GEMINI_BIN에 경로를 줍니다.
set -euo pipefail

GEMINI_BIN="${AISURADA_GEMINI_BIN:-gemini}"

is_uuid() {
    [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# 부속 명령과 정보 출력은 세션을 만들지 않으니 그대로 넘긴다
case "${1:-}" in
    mcp|extensions|extension|skills|hooks) exec "$GEMINI_BIN" "$@" ;;
esac
for arg in "$@"; do
    case "$arg" in
        -h|--help|-v|--version|--list-sessions|--delete-session|--delete-session=*) exec "$GEMINI_BIN" "$@" ;;
    esac
done

session_id=""
resume_value=""
has_session_flag=0
prev=""
for arg in "$@"; do
    if [[ "$prev" == "--session-id" ]]; then
        session_id="$arg"; has_session_flag=1
    elif [[ "$prev" == "--resume" || "$prev" == "-r" ]]; then
        resume_value="$arg"
    fi
    case "$arg" in
        --session-id=*) session_id="${arg#--session-id=}"; has_session_flag=1 ;;
        --resume=*) resume_value="${arg#--resume=}" ;;
    esac
    prev="$arg"
done

if [[ -n "$resume_value" ]]; then
    # 이어 열기: UUID일 때만 그 세션이다. latest나 번호는 어느 세션인지 여기서 알 수 없다
    if is_uuid "$resume_value"; then
        session_id="$(printf '%s' "$resume_value" | tr '[:upper:]' '[:lower:]')"
    else
        session_id=""
    fi
    exec_args=("$@")
elif [[ "$has_session_flag" == 1 ]]; then
    exec_args=("$@")
else
    session_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    exec_args=(--session-id "$session_id" "$@")
fi

# 부모 셸에서 물려받은 Claude·Codex 세션 변수는 이 Gemini 세션의 것이 아니다
unset CLAUDE_CODE_SESSION_ID CODEX_SESSION_ID CODEX_THREAD_ID

if [[ -n "$session_id" ]]; then
    export AISURADA_SESSION_ID="$session_id"
    export AISURADA_SESSION_AGENT="gemini"
else
    # 어느 세션인지 모르면 물려받은 값이 엉뚱한 세션을 가리키지 않게 지운다
    unset AISURADA_SESSION_ID AISURADA_SESSION_AGENT
fi

exec "$GEMINI_BIN" "${exec_args[@]}"
