#!/bin/sh
# 개발용 번들(`target/…/bundle`)의 ais-cli. 정식 번들(`pnpm release:build`)에는 이 자리에 Rust 실행 파일이 들어간다.
# 이 스크립트는 저장소의 빌드 폴더에서 찾은 실행 파일(engine-rs/target/{release,debug}/ais-cli)로 그대로 넘긴다.
#   먼저 (cd engine-rs && cargo build -p ais-cli)로 지어 둔다. AISURADA_CLI_BIN으로 다른 실행 파일을 줄 수도 있다.
#
# PATH가 비어 있어도(Finder나 launchd가 띄운 환경) 돌아야 하므로 셸 내장 기능만 쓴다.
# 외부 명령은 절대 경로로 부르는 readlink 하나뿐이다.

self=$0
while [ -h "$self" ]; do
  link=$(/usr/bin/readlink "$self")
  case $self in
    */*) dir=${self%/*} ;;
    *) dir=. ;;
  esac
  case $link in
    /*) self=$link ;;
    *) self=$dir/$link ;;
  esac
done
case $self in
  */*) dir=${self%/*} ;;
  *) dir=. ;;
esac
here=$(cd "$dir" && pwd -P)

bin=${AISURADA_CLI_BIN:-}
if [ -z "$bin" ]; then
  # 위로 올라가며 engine-rs/Cargo.toml이 있는 저장소 뿌리를 찾는다
  d=$here
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    if [ -f "$d/engine-rs/Cargo.toml" ]; then
      for profile in release debug; do
        if [ -x "$d/engine-rs/target/$profile/ais-cli" ]; then
          bin=$d/engine-rs/target/$profile/ais-cli
          break
        fi
      done
      break
    fi
    d=${d%/*}
  done
fi

if [ -z "$bin" ] || [ ! -x "$bin" ]; then
  echo "ais-cli 실행 파일을 못 찾았다. (cd engine-rs && cargo build -p ais-cli) 로 짓거나 AISURADA_CLI_BIN에 자리를 준다." >&2
  exit 127
fi
exec "$bin" "$@"
