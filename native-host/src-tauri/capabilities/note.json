{
  "identifier": "note",
  "windows": [
    "note-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:deny-read-file",
    "fs:deny-read-text-file-lines",
    "fs:deny-read-text-file-lines-next",
    "core:event:deny-emit",
    "core:event:deny-emit-to"
  ]
}
