{
  "name": "aisurada-native-host",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/setup-plugs.mjs",
    "build": "pnpm typecheck && vite build",
    "build:noclaude": "pnpm typecheck && vite build --mode noclaude",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "check:screen": "node scripts/check-web.mjs",
    "test:screen": "node --test scripts/screen-contracts.test.mjs",
    "test:workspace": "node --experimental-strip-types --test scripts/workspace.test.mjs scripts/migration.test.mjs",
    "test:navigation": "node --experimental-strip-types --test scripts/navigation.test.mjs",
    "test:interaction": "node --experimental-strip-types --test scripts/interaction.test.mjs scripts/deeplink-bridge.test.mjs",
    "test:data": "node --experimental-strip-types --test scripts/data.test.mjs",
    "test:data:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --data",
    "test:interaction:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --interaction",
    "test:navigation:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --navigation",
    "test:workspace:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs",
    "backend:jars": "bash ../build.sh",
    "release:runtime": "node scripts/prepare-runtime.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "tauri": "tauri",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:editor": "node --import tsx --test scripts/editor.test.mjs",
    "test:editor:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --editor",
    "test:autosave": "node --import tsx --test scripts/autosave.test.mjs",
    "test:autosave:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --autosave",
    "test:views": "node --import tsx --test scripts/views.test.mjs",
    "test:chapters": "node --import tsx --test scripts/chapters14-17.test.mjs",
    "test:cli-script": "node --test scripts/ais-cli-script.test.mjs",
    "docs:guide": "node scripts/guide2html.mjs ../docs/developer-guide.md ../docs/developer-guide.html",
    "test:views:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --views",
    "test:part4:acceptance": "pnpm build && node scripts/workspace-acceptance.mjs --part4",
    "test:ask-marks:acceptance": "pnpm build:noclaude && node scripts/workspace-acceptance.mjs --ask-marks"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "parse5": "8.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@lexical/clipboard": "0.47.0",
    "@lexical/code": "0.47.0",
    "@lexical/headless": "0.47.0",
    "@lexical/history": "0.47.0",
    "@lexical/html": "0.47.0",
    "@lexical/link": "0.47.0",
    "@lexical/list": "0.47.0",
    "@lexical/mark": "0.47.0",
    "@lexical/markdown": "0.47.0",
    "@lexical/react": "0.47.0",
    "@lexical/rich-text": "0.47.0",
    "@lexical/selection": "0.47.0",
    "@lexical/table": "0.47.0",
    "@lexical/utils": "0.47.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "js-yaml": "4.1.1",
    "lexical": "0.47.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
